---
import Layout from '../layouts/Layout.astro';
import { Card } from '../components/common/Card';
import { TextField } from '../components/common/TextField';
import { Button } from '../components/common/Button';
import { Logo } from '../components/common/Logo';
---

<Layout>
  <div class="min-h-screen w-full flex items-center justify-center p-4 bg-background">
    <Card className="w-full max-w-md p-8 flex flex-col gap-6 animate-fade-in-up">
      <!-- Header -->
      <div class="flex flex-col items-center text-center gap-4">
        <Logo size="lg" />
        <div>
          <h1 class="text-2xl font-bold text-on-surface">Create Account</h1>
          <p class="text-sm text-on-surface-variant mt-1">Join DocuMind AI to start analyzing documents.</p>
        </div>
      </div>

      <!-- Form -->
      <form class="flex flex-col gap-4">
        <TextField 
          placeholder="Full Name" 
          type="text" 
          icon="person" 
          required 
        />
        
        <TextField 
          placeholder="Email Address" 
          type="email" 
          icon="mail" 
          required 
        />

        <TextField 
          placeholder="Password" 
          type="password" 
          icon="lock" 
          required 
        />

        <TextField 
          placeholder="Confirm Password" 
          type="password" 
          icon="lock_reset" 
          required 
        />

        <Button variant="primary" size="lg" className="w-full mt-4">
          Create Account
        </Button>
      </form>

      <!-- Footer -->
      <div class="text-center mt-2">
        <p class="text-sm text-on-surface-variant">
          Already have an account? 
          <a href="/login" class="font-bold text-primary hover:text-primary/80 transition-colors ml-1">Log In</a>
        </p>
      </div>
    </Card>
  </div>
</Layout>

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }
</style>
